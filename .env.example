# 複製成 .env（docker compose 會自動讀）：cp .env.example .env
# .env 已在 .gitignore 與 .dockerignore 裡，不要提交真正的金鑰。

# ---- 認證（必填）----
# 網頁介面／HTTP API 的 token；產生：openssl rand -hex 24
VIDPIPE_API_TOKEN=
# vidgrab 的 token；compose 內 vidgrab 服務會用同一個值，所以兩邊自動一致
VIDGRAB_API_TOKEN=

# ---- 素材站金鑰（交給 vidgrab；沒填的來源會自己略過）----
PIXABAY_API_KEY=
JAMENDO_CLIENT_ID=
PEXELS_API_KEY=

# ---- 旁白：主機上的 audio.cpp（或任何 /v1/audio/speech）----
# 容器連不到主機的 127.0.0.1；host.docker.internal 在 Docker Desktop 內建，
# Linux 由 compose 的 extra_hosts 補上。audio.cpp 要聽 0.0.0.0（或 docker0 位址），不能只聽 127.0.0.1。
VIDPIPE_TTS_BASE_URL=http://host.docker.internal:8301
VIDPIPE_TTS_TOKEN=
VIDPIPE_TTS_MODEL=
# 音色參考音檔：路徑是「audio.cpp 那台主機上」的路徑（不是容器內的），例如 /Users/me/voice/ref.wav
VIDPIPE_VOICE_REF=
VIDPIPE_REFERENCE_TEXT=

# ---- 字幕 ----
VIDPIPE_SUBTITLE_LANGS=zh-TW
# 映像內建 Noto Sans CJK TC；要換字體需自己再裝進映像
VIDPIPE_SUBTITLE_FONT=Noto Sans CJK TC

# ---- 發佈 ----
# 只對本機發佈。要讓別台機器連，改成 0.0.0.0（token 一定要設）
VIDPIPE_BIND=127.0.0.1
VIDPIPE_PUBLISH_PORT=8311
# 用網域名稱連網頁介面時，把它加進來（逗號分隔）
VIDPIPE_ALLOWED_HOSTS=
# vidgrab 原始碼位置（compose 會從這裡建映像）；預設與 vidpipe 並排
VIDGRAB_SRC=../vidgrab
