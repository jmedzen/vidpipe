# vidpipe 環境變數範例（複製成 .env 再改）。優先序：環境變數 > vidpipe.json > 預設。

# 網頁介面（serve）的 token；綁 0.0.0.0（容器）時一定要設
VIDPIPE_API_TOKEN=change-me

# vidgrab：vidpipe「後端」連它用的位址
#   本機直接跑：http://127.0.0.1:8310（預設）
#   compose 同網路：http://vidgrab:8310
VIDPIPE_VIDGRAB_URL=http://vidgrab:8310
#VIDPIPE_VIDGRAB_TOKEN=

# vidgrab：「瀏覽器」開它的網頁用的位址（總覽頁的「開啟 vidgrab」按鈕）
#   留空 = 從上面的位址推；本機跑不用設。
#   容器服務名（http://vidgrab:8310）瀏覽器打不開，Docker／NAS 請填你在瀏覽器實際輸入的網址：
VIDPIPE_VIDGRAB_PUBLIC_URL=http://192.168.1.10:8310

# audio.cpp（Mac 本機；容器連主機用 host.docker.internal）
VIDPIPE_TTS_BASE_URL=http://host.docker.internal:8301
