# 複製成 .env（docker compose 會自動讀）：cp .env.example .env
# .env 已在 .gitignore 與 .dockerignore 裡，不要提交真正的金鑰。

# ---- 認證（必填）----
# 網頁介面／HTTP API 的 token；產生：openssl rand -hex 24
VIDPIPE_API_TOKEN=
# vidgrab 的 token；compose 內 vidgrab 服務會用同一個值，所以兩邊自動一致
VIDGRAB_API_TOKEN=

# ---- 素材站金鑰（交給 vidgrab；沒填的來源會自己略過）----
PIXABAY_API_KEY=
JAMENDO_CLIENT_ID=
PEXELS_API_KEY=

# ---- 旁白：MacBook 上的 audio.cpp（不在容器裡，要 GPU）----
# NAS 的容器經區網連 Mac，不能用 localhost／host.docker.internal。Mac 要有固定 IP（路由器 DHCP 保留）。
# audio.cpp 要聽區網位址：啟動時加 --host <Mac 的 IP>（見 README），並限制誰連得到。
# 寫在這裡，網頁「設定」頁就會把 TTS 位址顯示成「由環境變數指定」並鎖住；想在網頁改就把這行註解掉。
VIDPIPE_TTS_BASE_URL=http://192.168.2.66:8301
VIDPIPE_TTS_TOKEN=
VIDPIPE_TTS_MODEL=
# 音色參考音檔：路徑是「Mac 上」的路徑（不是 NAS、不是容器內的），例如 /Users/me/voice/ref.wav
VIDPIPE_VOICE_REF=
VIDPIPE_REFERENCE_TEXT=

# ---- NAS 資料夾（選填；不填就用 Docker volume）----
# 填絕對路徑會變成 bind mount。容器以 uid 1000 執行，資料夾要先 chown 1000:1000（或給寫入權限）。
# VIDGRAB_DATA_DIR=/volume1/docker/vidpipe/vidgrab
# VIDPIPE_WORK_DIR=/volume1/docker/vidpipe/work
# VIDPIPE_OUT_DIR=/volume1/docker/vidpipe/out

# ---- 字幕（選填）----
# 留空 = 在網頁「設定」頁改。寫在這裡的項目，設定頁會標成「由環境變數指定」並鎖住，只能改這個檔再重啟。
#VIDPIPE_SUBTITLE_LANGS=zh-TW
# 映像內建 Noto Sans CJK TC（預設字體）；要換字體需自己再裝進映像
#VIDPIPE_SUBTITLE_FONT=Noto Sans CJK TC

# ---- vidgrab 的網頁位址（瀏覽器用）----
# 總覽頁「開啟 vidgrab」按鈕用。容器服務名瀏覽器打不開，NAS 請填你實際輸入的網址，例如 http://192.168.2.10:8310
VIDPIPE_VIDGRAB_PUBLIC_URL=

# ---- vidgrab 的網頁位址（瀏覽器用）----
# 總覽頁「開啟 vidgrab」按鈕用。容器服務名瀏覽器打不開，NAS 請填你實際輸入的網址，例如 http://192.168.2.10:8310
VIDPIPE_VIDGRAB_PUBLIC_URL=

# ---- 發佈 ----
# 只對本機發佈。要讓別台機器連，改成 0.0.0.0（token 一定要設）
VIDPIPE_BIND=127.0.0.1
VIDPIPE_PUBLISH_PORT=8311
# 用網域名稱連網頁介面時，把它加進來（逗號分隔）
VIDPIPE_ALLOWED_HOSTS=
# vidgrab 原始碼位置（compose 會從這裡建映像）；預設與 vidpipe 並排
VIDGRAB_SRC=../vidgrab
# build number 由 tools/compose-up.sh 從 git 帶入，不用在這裡設
